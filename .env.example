DATABASE_URL=sqlite:///./outreachpilot.db
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI-compatible endpoint. Leave API key empty to use deterministic fallback generation.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Configurable positioning used in drafts.
VALUE_PROPOSITION=We help revenue teams automate evidence-based account research and qualification so reps can spend more time in conversations.
SENDER_NAME=Alex

# Delivery is mock by default. Set DELIVERY_MODE=webhook and configure a public HTTPS URL to POST approved drafts.
DELIVERY_MODE=mock
OUTBOUND_WEBHOOK_URL=

# n8n inbound webhook behavior. Automatic send is never supported.
WEBHOOK_AUTO_PROCESS=false
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_BYTES=1000000

